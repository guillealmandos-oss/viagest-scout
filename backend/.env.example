APP_NAME=Viagest Scout API
APP_ENV=development
# Local dev default:
DATABASE_URL=sqlite:///./travel_strategy.db
# Railway / Postgres production example:
# DATABASE_URL=postgresql://user:password@host:5432/railway
# Proveedor por defecto (datos reales). Recomendado: Amadeus producción.
FLIGHT_PROVIDER=amadeus
# FLIGHT_PROVIDERS=amadeus
# FLIGHT_PROVIDERS=amadeus,duffel
# Solo para desarrollo local con inventario falso (no usar en Railway producción):
# ALLOW_DUFFEL_TEST=true
# FLIGHT_PROVIDERS=demo
FLIGHT_PROVIDERS=amadeus
ALLOW_DUFFEL_TEST=false
# Provider-specific request timeouts in seconds. Examples:
# PROVIDER_TIMEOUTS=duffel:30,amadeus:25
# PROVIDER_TIMEOUTS={"duffel":30,"amadeus":25}
PROVIDER_TIMEOUTS=duffel:30,amadeus:25,demo:5
DEFAULT_CURRENCY=USD
# Optional: single frontend URL merged into CORS if ALLOWED_ORIGINS is awkward to edit:
# FRONTEND_ORIGIN=https://your-frontend.up.railway.app
# Add your deployed frontend URL in production, for example:
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://viagest-scout.up.railway.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Duffel (solo token LIVE para datos reales; duffel_test_* está bloqueado por defecto)
# DUFFEL_API_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2
# Amadeus — registro en developers.amadeus.com, luego claves de producción
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# Producción (vuelos reales, cuota mensual gratuita + pago por excedente):
AMADEUS_BASE_URL=https://api.amadeus.com
# Sandbox (solo si ALLOW_DUFFEL_TEST=true en local):
# AMADEUS_BASE_URL=https://test.api.amadeus.com
